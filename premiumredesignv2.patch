@@ -1 +1,82 @@
 @import "tailwindcss";
+
+@import url('https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;800;900&family=Playfair+Display:ital,wght@0,400;0,700;1,400&display=swap');
+
+/* ─── ALMAASA DESIGN TOKENS ───────────────────────────────── */
+:root {
+  --color-primary:    #9A2D55;
+  --color-primary-hover: #802446;
+  --color-gold:       #C4956A;
+  --color-gold-light: #E8D5C4;
+  --color-cream:      #FDF8F5;
+  --color-cream-2:    #F8EDE8;
+  --color-cream-3:    #F2E4DC;
+  --color-muted:      #9B8178;
+  --color-dark:       #2C1810;
+}
+
+/* ─── BASE ────────────────────────────────────────────────── */
+html { scroll-behavior: smooth; }
+
+body {
+  font-family: 'Cairo', system-ui, sans-serif;
+  background-color: var(--color-cream);
+  color: var(--color-dark);
+  -webkit-font-smoothing: antialiased;
+}
+
+/* ─── SCROLLBAR ──────────────────────────────────────────── */
+::-webkit-scrollbar { width: 5px; height: 5px; }
+::-webkit-scrollbar-track { background: #f8ede8; }
+::-webkit-scrollbar-thumb { background: #d4a5a5; border-radius: 99px; }
+
+/* ─── SELECTION ──────────────────────────────────────────── */
+::selection { background: #9A2D55; color: white; }
+
+/* ─── LUXURY CARD HOVER ──────────────────────────────────── */
+.luxury-card {
+  transition: transform 0.35s cubic-bezier(.22,.68,0,1.2), box-shadow 0.35s ease;
+}
+.luxury-card:hover {
+  transform: translateY(-6px);
+  box-shadow: 0 20px 40px -12px rgba(154,45,85,0.18);
+}
+
+/* ─── PRODUCT IMAGE ZOOM ─────────────────────────────────── */
+.product-img { transition: transform 0.6s cubic-bezier(.22,.68,0,1.2); }
+.luxury-card:hover .product-img { transform: scale(1.08); }
+
+/* ─── FADE IN ────────────────────────────────────────────── */
+@keyframes fadeUp {
+  from { opacity: 0; transform: translateY(20px); }
+  to   { opacity: 1; transform: translateY(0); }
+}
+.fade-up { animation: fadeUp 0.6s ease forwards; }
+
+/* ─── SHIMMER SKELETON ───────────────────────────────────── */
+@keyframes shimmer {
+  0%   { background-position: -1000px 0; }
+  100% { background-position: 1000px 0; }
+}
+.skeleton {
+  background: linear-gradient(90deg, #f0e6e0 25%, #f8ede8 50%, #f0e6e0 75%);
+  background-size: 1000px 100%;
+  animation: shimmer 1.5s infinite;
+  border-radius: 12px;
+}
+
+/* ─── TOAST ──────────────────────────────────────────────── */
+@keyframes toastIn {
+  from { transform: translateX(100%); opacity: 0; }
+  to   { transform: translateX(0); opacity: 1; }
+}
+.toast-enter { animation: toastIn 0.35s ease; }
+
+/* ─── HIDE SCROLLBAR (stories row) ──────────────────────── */
+.no-scrollbar::-webkit-scrollbar { display: none; }
